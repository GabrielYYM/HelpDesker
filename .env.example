# ==============================================================
# DeskHelper - Exemplo de Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env e preencha com suas configurações reais
# ==============================================================

# --------------------------------------------------------------
# BACKEND (Spring Boot)
# --------------------------------------------------------------
# Em producao, o Render fornece PORT automaticamente.
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Conexão MongoDB Atlas (ou MongoDB Local)
# Substitua pela URL do MongoDB Atlas, sem aspas em volta do valor.
MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/deskhelper?retryWrites=true&w=majority
MONGODB_DATABASE=deskhelper

# Banco de Dados Relacional (JPA) - Caso aplicável
# DATABASE_URL=jdbc:postgresql://localhost:5432/deskhelper
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=postgres

# Autenticação e Segurança (JWT)
JWT_SECRET=coloque_aqui_uma_chave_secreta_longa_e_segura
JWT_EXPIRATION=86400000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Cookies de sessao e CSRF. No Render, use true e None.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=Lax

# As variaveis do frontend ficam em frontend/.env (veja frontend/.env.example).
